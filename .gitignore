# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Built motion-matching cache (regenerated from the CSVs on first run)
data/motion_lib.npz

# SONIC low_latency / sonic_v1_1 decoders are ~150 MB (over GitHub's 100 MB
# file limit); assets/sonic/policy/fetch_models.sh downloads them
assets/sonic/policy/low_latency/*.onnx
assets/sonic/policy/sonic_v1_1/*.onnx

# default (unnamed) output of scenebot_g1_box/run_mm_pickup.py; curated
# renders are committed under explicit names
scenebot_g1_box/out/scenebot_mm_pickup.mp4

# stress-test videos stay on disk only (44 x ~7 MB); report/plots/metrics are committed
scenebot_g1_box/out/stress/*.mp4
scenebot_g1_box/out/stress_shape/*.mp4
scenebot_g1_box/out/stress_single/*.mp4

# per-clip tracking sweep videos (2 variants x 20 clips x ~7 MB) stay on disk
sonic_g1_box/out/track_clips/
