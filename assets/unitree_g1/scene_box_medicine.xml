<mujoco model="g1_box_medicine_scene">
  <!-- VARIANT of scene_box.xml: identical in every respect except that the interactive box is
       the printed 'MEDICINE' cardboard carton (tools/make_medicine_box.py) instead of the
       original scanned largebox. Used by `python run.py --medicine` and by the /medicine build
       of the web demo; the default scene keeps the plain box.

       The carton has the same bounding volume as the scan it replaces, so the pick/carry/place
       clips grip it identically -- box geometry is purely visual (the matcher only ever sees
       the box POSE from the data), so the two scenes produce exactly the same motion.

       The mesh path is relative to g1.xml's meshdir (assets/unitree_g1/assets); the texture
       path is relative to this file (no texturedir is set). -->
  <include file="g1.xml"/>

  <statistic center="0 0 0.8" extent="1.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.28 0.26 0.24 1"/>
    <global azimuth="120" elevation="-20" offwidth="1600" offheight="1600"/>
  </visual>

  <!-- Warm neutral (non-blue) studio palette: greige skybox + warm-grey checker floor. -->
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.56 0.52 0.47" rgb2="0.08 0.07 0.06" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.34 0.31 0.28"
             rgb2="0.22 0.20 0.18" markrgb="0.72 0.69 0.64" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <!-- The carton's UVs index a 3x2 atlas of its six faces, hence texuniform="false". rgba
         multiplies the texture: at 1.0 the headlight + overhead directional light sum to >1 on
         the upward-facing lid and burn the kraft out to white, so the print stops reading from
         above. 0.7 keeps the lid as cardboard without darkening the scene. -->
    <texture name="medicinebox_tex" type="2d" file="../largebox/medicinebox.png"/>
    <material name="medicinebox" texture="medicinebox_tex" texuniform="false"
              rgba="0.7 0.7 0.7 1" specular="0.05" shininess="0.05" reflectance="0"/>
    <mesh name="largebox_mesh" file="../../largebox/medicinebox.obj"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- The interactive box. Kinematic playback drives its freejoint qpos every frame; the
         geom has no collision (contype/conaffinity 0) since there is no physics. The body name
         must stay "largebox": run.py / the web exporter look the box up by it. -->
    <body name="largebox" pos="1.6 0 0.19">
      <freejoint name="box_joint"/>
      <geom type="mesh" mesh="largebox_mesh" contype="0" conaffinity="0"
            material="medicinebox"/>
    </body>
  </worldbody>
</mujoco>
